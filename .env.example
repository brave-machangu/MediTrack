# Local Docker Compose settings. `make up` copies this file to .env (git-ignored) if .env is missing.
# These values are for a throwaway local database only. Deployed environments get their
# secrets from GitHub Environments, never from this file (docs/security.md §3).

# Password of the local PostgreSQL user `meditrack` (docker-compose.yml builds DATABASE_URL from it).
POSTGRES_PASSWORD=meditrack-local-only
